# Yandex.Direct OAuth access token (получить: python -m yandex_direct_api_client.auth)
YANDEX_DIRECT_TOKEN=

# Refresh-токен для обновления access_token (опционально)
YANDEX_DIRECT_REFRESH_TOKEN=

# OAuth application id (для обновления токена)
YANDEX_DIRECT_CLIENT_ID=

# OAuth application secret (для обновления токена)
YANDEX_DIRECT_CLIENT_SECRET=

# Логин клиента Директа (например, DEG13)
YANDEX_DIRECT_CLIENT_LOGIN=

# Базовый URL API (по умолчанию https://api.direct.yandex.com/v5)
# YANDEX_DIRECT_API_URL=https://api.direct.yandex.com/v5

# Таймаут одного HTTP-запроса, сек
# YANDEX_DIRECT_TIMEOUT=30

# Максимум повторов при 429
# YANDEX_DIRECT_MAX_RETRIES=5

# Rate limit на стороне клиента, запросов в секунду
# YANDEX_DIRECT_RATE_LIMIT_RPS=5

# Включить readonly-режим (запрет mutating-методов): 1/0
# YANDEX_DIRECT_READONLY=0
